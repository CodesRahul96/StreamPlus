<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_controller_scrim">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_icon_btn"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_close_white"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/tv_player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="Stream Title"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_live_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="🔴 LIVE"
            android:textColor="#EF4444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_stream_quality_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_quality_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="AUTO"
            android:textColor="#06B6D4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/exo_speed_top"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_icon_btn"
            android:contentDescription="Playback Speed"
            android:padding="8dp"
            android:src="@drawable/ic_speed"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_playlist_top"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_player_icon_btn"
            android:contentDescription="Playlist"
            android:padding="8dp"
            android:src="@drawable/ic_playlist"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_player_icon_btn"
            android:contentDescription="Settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            android:tint="@android:color/white" />

    </LinearLayout>

    <!-- Center Controls: 10s Rewind, Play/Pause, 10s Fast Forward -->
    <LinearLayout
        android:id="@+id/center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@id/exo_rew"
            style="@style/ExoMediaButton.Rewind"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_player_center_btn"
            android:contentDescription="Rewind 10s"
            android:padding="12dp"
            android:src="@drawable/ic_replay_10"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/ExoMediaButton.Play"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/bg_player_play_pause_btn"
            android:padding="16dp"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@id/exo_ffwd"
            style="@style/ExoMediaButton.FastForward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_player_center_btn"
            android:contentDescription="Fast Forward 10s"
            android:padding="12dp"
            android:src="@drawable/ic_forward_10"
            android:tint="@android:color/white" />

    </LinearLayout>

    <!-- Bottom Section -->
    <LinearLayout
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Full Width Neon Progress Bar -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:bar_height="4dp"
            app:touch_target_height="28dp"
            app:buffered_color="#59FFFFFF"
            app:played_color="#06B6D4"
            app:scrubber_color="#38BDF8"
            app:scrubber_enabled_size="12dp"
            app:scrubber_dragged_size="16dp"
            app:unplayed_color="#26FFFFFF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- Combined Time Display -->
            <TextView
                android:id="@+id/tv_time_combined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="00:00 - 00:00" />
            
            <!-- Hidden original fields for ExoPlayer tracking -->
            <TextView android:id="@id/exo_position" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@id/exo_duration" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <!-- Bottom Actions Right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_pip"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_player_icon_btn"
                    android:contentDescription="PiP"
                    android:padding="8dp"
                    android:src="@drawable/ic_pip"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/exo_resize_mode_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_player_icon_btn"
                    android:contentDescription="Aspect Ratio"
                    android:padding="8dp"
                    android:src="@drawable/ic_aspect_ratio"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_landscape"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_player_icon_btn"
                    android:contentDescription="Orientation"
                    android:padding="8dp"
                    android:src="@drawable/ic_screen_rotation"
                    android:tint="@android:color/white" />

            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
        
</androidx.constraintlayout.widget.ConstraintLayout>
