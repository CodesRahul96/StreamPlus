    <!-- Settings FAQs -->
    <string name="faq_title">Help &amp; FAQ</string>
    <string name="accessibility_title">Accessibility</string>
    <string name="got_it_btn">Got it</string>
    <string name="faq_q1">How do I add a playlist?</string>
    <string name="faq_a1">Go to the Playlists tab, click the \'+\' button, and enter your M3U URL or select a local file.</string>
    <string name="faq_q2">What is DRM?</string>
    <string name="faq_a2">Digital Rights Management. Some channels require a license URL and a specific scheme (like Widevine) to play.</string>
    <string name="faq_q3">Why is my stream lagging?</string>
    <string name="faq_a3">Check your internet connection or try changing the \'Network Buffer Size\' in Settings &gt; General.</string>
    <string name="faq_q4">How to use Picture-in-Picture?</string>
    <string name="faq_a4">Enable \'Auto PiP\' in Settings &gt; Video settings. The player will minimize when you leave the app.</string>
    <string name="faq_q5">Can I play local videos?</string>
    <string name="faq_a5">Yes, go to the Gallery tab to browse and play videos stored on your device.</string>

