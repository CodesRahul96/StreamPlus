    <!-- Settings FAQs -->
    <string name="accessibility_title">अभिगम्यता</string>
    <string name="got_it_btn">समझ गया</string>
    <string name="faq_q1">मैं प्लेलिस्ट कैसे जोड़ूं?</string>
    <string name="faq_a1">प्लेलिस्ट टैब पर जाएं, \'+\' बटन पर क्लिक करें, और अपना एम3यू यूआरएल दर्ज करें या एक स्थानीय फ़ाइल चुनें।</string>
    <string name="faq_q2">डीआरएम क्या है?</string>
    <string name="faq_a2">डिजिटल राइट्स मैनेजमेंट। कुछ चैनलों को खेलने के लिए लाइसेंस यूआरएल और एक विशिष्ट योजना (जैसे वाइडवाइन) की आवश्यकता होती है।</string>
    <string name="faq_q3">मेरा स्ट्रीम लैग क्यों हो रहा है?</string>
    <string name="faq_a3">अपना इंटरनेट कनेक्शन जांचें या सेटिंग्स &gt; सामान्य में \'नेटवर्क बफर आकार\' बदलने का प्रयास करें।</string>
    <string name="faq_q4">पिक्चर-इन-पिक्चर का उपयोग कैसे करें?</string>
    <string name="faq_a4">सेटिंग्स &gt; वीडियो सेटिंग्स में \'ऑटो पिप\' सक्षम करें। जब आप ऐप छोड़ेंगे तो प्लेयर छोटा हो जाएगा।</string>
    <string name="faq_q5">क्या मैं स्थानीय वीडियो चला सकता हूँ?</string>
    <string name="faq_a5">हां, अपने डिवाइस पर संग्रहीत वीडियो ब्राउज़ करने और चलाने के लिए गैलरी टैब पर जाएं।</string>
    <string name="faq_title">सहायता और अक्सर पूछे जाने वाले प्रश्न</string>

