<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_playlist"
        android:enabled="true"
        android:icon="@drawable/ic_playlist"
        android:shortcutShortLabel="@string/shortcut_playlist"
        android:shortcutLongLabel="@string/shortcut_playlist">
        <intent
            android:action="com.codesrahul.streamplus.ACTION_OPEN_PLAYLIST"
            android:targetPackage="com.codesrahul.streamplus"
            android:targetClass="com.codesrahul.streamplus.SplashActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_gallery"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_gallery"
        android:shortcutLongLabel="@string/shortcut_gallery">
        <intent
            android:action="com.codesrahul.streamplus.ACTION_OPEN_GALLERY"
            android:targetPackage="com.codesrahul.streamplus"
            android:targetClass="com.codesrahul.streamplus.SplashActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_direct_stream"
        android:enabled="true"
        android:icon="@drawable/ic_play_shortcut"
        android:shortcutShortLabel="@string/shortcut_stream"
        android:shortcutLongLabel="@string/shortcut_stream">
        <intent
            android:action="com.codesrahul.streamplus.ACTION_OPEN_DIRECT_STREAM"
            android:targetPackage="com.codesrahul.streamplus"
            android:targetClass="com.codesrahul.streamplus.SplashActivity" />
    </shortcut>
</shortcuts>
